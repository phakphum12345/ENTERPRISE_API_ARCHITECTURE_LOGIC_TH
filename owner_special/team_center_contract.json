{
  "version": "2.0",
  "owner": {
    "user_id": "owner",
    "role": "owner",
    "services": ["research-os-api", "research-os-v3", "owner-friend"],
    "friend_service": "internal-only"
  },
  "users": [
    {"user_id": "user-a", "role": "member"},
    {"user_id": "user-b", "role": "engineer"},
    {"user_id": "user-c", "role": "agent"}
  ],
  "service_boundaries": {
    "research-os-api": "workspace",
    "research-os-v3": "team-engineering",
    "owner-friend": "friend-internal"
  },
  "discovery": {
    "contract": "ROS-PORT-DISCOVERY-001",
    "registry_schema_version": 1,
    "endpoint_identity": "service-id",
    "port_assignment": "operating-system",
    "ollama_endpoint": "externally-managed-unchanged"
  },
  "team_context": ["chat", "agents", "memory", "files", "tasks"],
  "authorization_rule": "identity -> role -> team -> permission; service port is not identity"
}
