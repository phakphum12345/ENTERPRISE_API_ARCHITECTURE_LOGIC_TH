<html><head><title>RECON-SYNC CENTER</title><HTA:APPLICATION ID="ReconSync" APPLICATIONNAME="Recon-Sync Center" BORDER="thin" CAPTION="yes" SHOWINTASKBAR="yes" SINGLEINSTANCE="yes"><style>body{font:14px Segoe UI;margin:24px;background:#111;color:#eee}button{padding:12px 18px;margin:6px;border:0;border-radius:8px}pre{background:#181818;padding:16px;border-radius:10px;min-height:280px;white-space:pre-wrap}</style></head><body><h1>RECON-SYNC CENTER</h1><div>Canonical control plane • fail-closed • provenance preserved</div><p><button onclick="run('sync')">RECON-SYNC</button><button onclick="run('audit')">AUDIT PLATFORM</button><button onclick="run('verify')">VERIFY</button><button onclick="run('evidence')">EVIDENCE</button><button onclick="run('status')">STATUS</button><button onclick="run('recover')">RECOVER</button></p><pre id="log">Ready.</pre><script>function run(cmd){var shell=new ActiveXObject("WScript.Shell");var fso=new ActiveXObject("Scripting.FileSystemObject");var p=decodeURIComponent(location.pathname).replace(/^\//,"").replace(/\//g,"\\");var root=fso.GetParentFolderName(fso.GetParentFolderName(p));var engine=fso.BuildPath(root,"platform\\recon-sync\\recon-sync-engine.ps1");var ex=shell.Exec('powershell.exe -NoProfile -ExecutionPolicy Bypass -File "'+engine+'" -Command '+cmd);document.getElementById("log").innerText=ex.StdOut.ReadAll();}</script></body></html>